# 서버 포트와 외부에서 접속하는 주소(알림 속 관리 링크에 쓰임)
PORT=3000
PUBLIC_URL=http://localhost:3000

# 새 공시가격 확인 주기(시간)
CHECK_INTERVAL_HOURS=6

# 1이면 공시가격 사이트 대신 가짜 데이터 사용(개발용)
REALTYPRICE_MOCK=0

# 기본 검색어와 지역 필터
DEFAULT_SEARCH=장미
DEFAULT_REGION=송파구

# 수동 확인 API(/api/admin/check)용 토큰
ADMIN_TOKEN=

# 이메일(SMTP). 비워 두면 이메일 알림이 꺼진다. 예: 네이버 smtp.naver.com:465, Gmail smtp.gmail.com:465(앱 비밀번호)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 텔레그램 봇(@BotFather로 생성). 비워 두면 텔레그램 알림이 꺼진다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# ntfy 서버(기본 공개 서버)
NTFY_SERVER=https://ntfy.sh

# 일정 알림: "MM-DD|제목|본문;MM-DD|제목|본문" (비우면 3/15 열람, 4/29 결정공시 기본값)
REMINDERS=
